rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() in [
          'syedsame2244@gmail.com',
          'syedsameer2244@gmail.com',
          'admin@thinkbotz.in'
        ] ||
        request.auth.token.isSuperAdmin == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTenantAdmin(tenantId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminEmail.lower() == request.auth.token.email.lower()
      );
    }

    function getAssociateUser(tenantId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantAssociateOrAdmin(tenantId) {
      return isTenantAdmin(tenantId) || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAssociateUser(tenantId).tenantId == tenantId &&
        getAssociateUser(tenantId).role in ['admin', 'associate', 'coordinator', 'president']
      );
    }

    function canManageEvents(tenantId) {
      return isTenantAdmin(tenantId) || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAssociateUser(tenantId).tenantId == tenantId &&
        (
          getAssociateUser(tenantId).role in ['admin', 'coordinator', 'president'] ||
          (getAssociateUser(tenantId).role == 'associate' && getAssociateUser(tenantId).powers.canManageEvents == true)
        )
      );
    }

    function canManageAnnouncements(tenantId) {
      return isTenantAdmin(tenantId) || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAssociateUser(tenantId).tenantId == tenantId &&
        (
          getAssociateUser(tenantId).role in ['admin', 'coordinator', 'president'] ||
          (getAssociateUser(tenantId).role == 'associate' && getAssociateUser(tenantId).powers.canManageAnnouncements == true)
        )
      );
    }

    function canManageGallery(tenantId) {
      return isTenantAdmin(tenantId) || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAssociateUser(tenantId).tenantId == tenantId &&
        (
          getAssociateUser(tenantId).role in ['admin', 'coordinator', 'president'] ||
          (getAssociateUser(tenantId).role == 'associate' && getAssociateUser(tenantId).powers.canManageGallery == true)
        )
      );
    }

    // --- 1. Tenants Collection ---
    // Anyone can read active tenant metadata for branding and login routing
    // Only Super Admin can write/create/delete tenants
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- 2. Users Collection ---
    // Read:
    //   - Super Admins can read all profiles across the platform
    //   - Authenticated users can read their own profile document
    //   - Tenant Admins, Associates, and Coordinators can read users within their own department/tenant
    // Create: Super Admin, or user creating their own profile upon authenticating
    // Update: Super Admin, Tenant Admin for their tenant's users, or user updating their own profile
    // Note: Students CANNOT elevate their own role or tamper with isSuperAdmin
    match /users/{userId} {
      allow read: if isSuperAdmin() || 
        (isAuthenticated() && request.auth.uid == userId) ||
        (resource.data.tenantId != null && isTenantAssociateOrAdmin(resource.data.tenantId));
      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId))
        )
      );
      allow update: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || (
        isOwner(userId) &&
        // Self-updates cannot elevate role or change super admin status or change tenantId
        request.resource.data.role == resource.data.role &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin &&
        request.resource.data.tenantId == resource.data.tenantId
      );
      allow delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
    }

    // --- 3. Events Collection ---
    // Read: Public for showcase and campus event discovery
    // Create, Update, Delete: Super Admin, Tenant Admin, or authorized Associate/Coordinator of that tenant
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && canManageEvents(request.resource.data.tenantId)
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && canManageEvents(resource.data.tenantId)
      );
    }

    // --- 4. Registrations Collection ---
    // Read: Super Admin, Tenant Admin, event coordinators, or the registered student
    // Create: Authenticated student registering themselves or admin
    // Update:
    //   - Admins / Coordinators can update anything (including attendance status)
    //   - Students can update their registration (e.g. team members) BUT CANNOT change their status (no self-attendance validation!)
    match /registrations/{regId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.tenantId != null && isTenantAssociateOrAdmin(resource.data.tenantId)) ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)) ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAssociateOrAdmin(resource.data.tenantId)
      ) || (
        isAuthenticated() && 
        resource.data.studentId == request.auth.uid &&
        // CRITICAL: Students CANNOT self-mark status: 'Attended' or alter verification metadata
        request.resource.data.status == resource.data.status &&
        request.resource.data.attendedAt == resource.data.attendedAt &&
        request.resource.data.verifiedBy == resource.data.verifiedBy
      );
      allow delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAssociateOrAdmin(resource.data.tenantId)
      ) || (
        isAuthenticated() && resource.data.studentId == request.auth.uid
      );
    }

    // --- 5. Albums (Gallery) Collection ---
    match /albums/{albumId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && canManageGallery(request.resource.data.tenantId)
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && canManageGallery(resource.data.tenantId)
      );
    }

    // --- 6. Announcements Collection ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && canManageAnnouncements(request.resource.data.tenantId)
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && canManageAnnouncements(resource.data.tenantId)
      );
    }

    // --- 7. Certificates Collection ---
    // Read: Public (crucial for QR verification and employer validation at /verify/:id)
    // Write: Super Admin or Tenant Admin
    match /certificates/{certId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
    }

    // --- 8. Event Winners Collection ---
    match /event_winners/{winnerId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAssociateOrAdmin(request.resource.data.tenantId)
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAssociateOrAdmin(resource.data.tenantId)
      );
    }

    // --- 9. App Settings / Config ---
    // Read: Public for branding and portal display
    // Write: Super Admin or Tenant Admin for that tenant's document
    match /appSettings/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isTenantAdmin(configId);
    }

    // --- 10. Universal Platform Settings (Developer Profiles & System Config) ---
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- 11. Enterprise Immutable Audit Logs ---
    // Read: Super Admin, or Tenant Admin for their tenant
    // Create: Authenticated users/admins performing audited actions
    // Update/Delete: Only Super Admin (tamper-resistant)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // --- 12. Deleted Items Safety Vault (Zero-Loss Recoverable Backups) ---
    // Read: Super Admin, or Tenant Admin for their tenant
    // Create: Authenticated users/admins performing soft-deletions
    // Update/Delete: Super Admin only
    match /deleted_backups/{backupId} {
      allow read: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // --- 13. Support Tickets & Student Query Desk ---
    match /support_tickets/{ticketId} {
      allow read: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() || request.resource.data.tenantId != null;
      allow update: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
    }

    // --- 14. System Crash Logs & Diagnostics ---
    // Read & Delete: Super Admin only
    // Create: Anyone (including unauthenticated or pre-login clients capturing crashes)
    // Update: Super Admin only (for marking resolved)
    match /system_logs/{logId} {
      allow read, delete, update: if isSuperAdmin();
      allow create: if true;
    }
  }
}
