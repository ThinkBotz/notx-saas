rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'syedsame2244@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTenantAdmin(tenantId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminEmail.lower() == request.auth.token.email.lower()
      );
    }

    // --- 1. Tenants Collection ---
    // Anyone can read tenant metadata (necessary for login dropdown & tenant branding)
    // Only Super Admin can create, modify, deactivate, or delete tenants
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- 2. Users Collection ---
    // Read: Allowed for public lookup during synthetic roll login and member directory
    // Create: Allowed for auth setup, admin bulk creation, or self-creation on Google sign-in
    // Update: User can update their own profile, Tenant Admin for their tenant, or Super Admin
    // Delete: Tenant Admin or Super Admin
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update: if isSuperAdmin() || isOwner(userId) || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
      allow delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      );
    }

    // --- 3. Events Collection ---
    // Read: Public / department access
    // Write: Super Admin, or Tenant Admin of that tenant
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      ) || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || isAuthenticated();
    }

    // --- 4. Registrations Collection ---
    // Read: Authenticated users
    // Create: Authenticated users
    // Update/Delete: Super Admin, Tenant Admin, or the student who registered
    match /registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // --- 5. Albums (Gallery) Collection ---
    match /albums/{albumId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      ) || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || isAuthenticated();
    }

    // --- 6. Announcements Collection ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      ) || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || isAuthenticated();
    }

    // --- 7. Certificates Collection ---
    // Read: Public (crucial for employer / QR credential verification at /verify/:id)
    // Write: Super Admin or Tenant Admin
    match /certificates/{certId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      ) || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || isAuthenticated();
    }

    // --- 8. Event Winners Collection ---
    match /event_winners/{winnerId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        request.resource.data.tenantId != null && isTenantAdmin(request.resource.data.tenantId)
      ) || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        resource.data.tenantId != null && isTenantAdmin(resource.data.tenantId)
      ) || isAuthenticated();
    }

    // --- 9. App Settings / Config ---
    // Read: Public (for app branding & theme on login / landing screen)
    // Write: Super Admin or authenticated admin
    match /appSettings/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // --- 12. Universal Platform Settings (Developer Profiles & System Config) ---
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // --- 13. Enterprise Immutable Audit Logs ---
    // Read: Super Admin
    // Create: Allowed for authenticated users and admins to log activities
    // Update/Delete: Only Super Admin (audit logs are tamper-resistant)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // --- 14. Deleted Items Safety Vault (Zero-Loss Recoverable Backups) ---
    // Read: Super Admin
    // Create: Authenticated users/admins performing deletions with soft-delete backups
    // Update (Restore) & Delete (Purge): Super Admin
    match /deleted_backups/{backupId} {
      allow read: if isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // --- 15. Support Tickets & Student Query Desk ---
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin() || isAuthenticated();
    }
  }
}

